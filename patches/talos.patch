+)
+
+var _ system.HealthcheckedService = (*WpaSupplicant)(nil)
+
+// WpaSupplicant implements the Service interface, running a wpa_supplicant
+// instance for a single wireless interface.
+type WpaSupplicant struct {
+	LinkName string
+}
+
+// WpaSupplicantServiceID returns the service ID for the given wireless link.
+func WpaSupplicantServiceID(linkName string) string {
+	return "wpa-supplicant-" + linkName
+}
+
+// WpaSupplicantConfigPath returns the wpa_supplicant configuration file path for the given wireless link.
+func WpaSupplicantConfigPath(linkName string) string {
+	return filepath.Join(constants.WpaSupplicantRunDir, linkName+".conf")
+}
+
+// WpaSupplicantExecutablePath resolves the wpa_supplicant binary location.
+//
+// The binary is shipped by the wifi system extension (/usr/local/bin), with
+// /usr/bin as a fallback for custom builds.
+func WpaSupplicantExecutablePath() (string, error) {
+	for _, path := range []string{
+		constants.WpaSupplicantExtensionExecutablePath,
+		constants.WpaSupplicantBakedExecutablePath,
+	} {
+		if _, err := os.Stat(path); err == nil {
+			return path, nil
+		}
+	}
+
+	return "", fmt.Errorf("wpa_supplicant binary is not available (checked %q and %q): is the wifi system extension installed?",
+		constants.WpaSupplicantExtensionExecutablePath, constants.WpaSupplicantBakedExecutablePath)
+}
+
+// ID implements the Service interface.
+func (svc *WpaSupplicant) ID(runtime.Runtime) string {
+	return WpaSupplicantServiceID(svc.LinkName)
+}
+
+// PreFunc implements the Service interface.
+func (svc *WpaSupplicant) PreFunc(context.Context, runtime.Runtime) error {
+	return disablePiWiFiPowerSave(svc.LinkName)
+}
+
+// PostFunc implements the Service interface.
+func (svc *WpaSupplicant) PostFunc(runtime.Runtime, events.ServiceState) error {
+	return nil
+}
+
+// Condition implements the Service interface.
+func (svc *WpaSupplicant) Condition(runtime.Runtime) conditions.Condition {
+	return conditions.WaitForFileToExist(WpaSupplicantConfigPath(svc.LinkName))
+}
+
+// DependsOn implements the Service interface.
+func (svc *WpaSupplicant) DependsOn(runtime.Runtime) []string {
+	return nil
+}
+
+// Volumes implements the Service interface.
+func (svc *WpaSupplicant) Volumes(runtime.Runtime) []string {
+	return nil
+}
+
+// Runner implements the Service interface.
+func (svc *WpaSupplicant) Runner(r runtime.Runtime) (runner.Runner, error) {
+	executablePath, err := WpaSupplicantExecutablePath()
+	if err != nil {
+		return nil, err
+	}
+
+	args := &runner.Args{
+		ID: svc.ID(r),
+		ProcessArgs: []string{
+			executablePath,
+			"-i", svc.LinkName,
+			"-D", "nl80211",
+			"-c", WpaSupplicantConfigPath(svc.LinkName),
+		},
+	}
+
+	debug := false
+
+	if r.Config() != nil {
+		debug = r.Config().Debug()
+	}
+
+	// drop all capabilities except those required to drive the wireless interface
+	droppedCapabilities := capability.AllCapabilitiesSetLowercase()
+	delete(droppedCapabilities, "cap_net_admin")
+	delete(droppedCapabilities, "cap_net_raw")
+
+	return restart.New(
+		process.NewRunner(
+			debug,
+			args,
+			runner.WithLoggingManager(r.Logging()),
+			runner.WithCgroupPath(constants.CgroupWpaSupplicant),
+			runner.WithSelinuxLabel(constants.SelinuxLabelWpaSupplicant),
+			runner.WithDroppedCapabilities(droppedCapabilities),
+		),
+		restart.WithType(restart.Forever),
+	), nil
+}
+
+// HealthFunc implements the HealthcheckedService interface.
+func (svc *WpaSupplicant) HealthFunc(runtime.Runtime) health.Check {
+	return func(ctx context.Context) error {
+		// wpa_supplicant creates a control socket per interface once it has
+		// successfully initialized the driver.
+		if err := conditions.WaitForFileToExist(filepath.Join(constants.WpaSupplicantRunDir, svc.LinkName)).Wait(ctx); err != nil {
+			return fmt.Errorf("wpa_supplicant control socket is not available: %w", err)
+		}
+
+		return nil
+	}
+}
+
+// HealthSettings implements the HealthcheckedService interface.
+func (svc *WpaSupplicant) HealthSettings(runtime.Runtime) *health.Settings {
+	return &health.DefaultSettings
+}
diff --git a/internal/pkg/rpi5diag/diag_linux.go b/internal/pkg/rpi5diag/diag_linux.go
new file mode 100644
index 0000000..edc3f27
--- /dev/null
+++ b/internal/pkg/rpi5diag/diag_linux.go
@@ -0,0 +1,241 @@
+// Package rpi5diag provides opt-in diagnostics for the one-time Pi boot test.
+package rpi5diag
+
+import (
+	"errors"
+	"fmt"
+	"log"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// Save writes the kernel log only to the existing, explicitly marked test directory.
+// It never creates partitions or writes to the Raspberry Pi OS root filesystem.
+func Save(stage string) {
+	cmdline, err := os.ReadFile("/proc/cmdline")
+	if err != nil || !strings.Contains(" "+strings.TrimSpace(string(cmdline))+" ", " talos.rpi5.diag=1 ") {
+		return
+	}
+
+	if err := save(stage); err != nil {
+		log.Printf("Pi boot diagnostics: %v", err)
+	}
+}
+
+func save(stage string) error {
+	var moduleDir string
+	for _, root := range []string{"/usr/lib/modules", "/root/usr/lib/modules"} {
+		matches, _ := filepath.Glob(root + "/*/modules.dep")
+		if len(matches) == 1 {
+			moduleDir = filepath.Dir(matches[0])
+			break
+		}
+	}
+	if moduleDir == "" {
+		return errors.New("kernel module directory is not available")
+	}
+
+	data, err := os.ReadFile(filepath.Join(moduleDir, "modules.dep"))
+	if err != nil {
+		return err
+	}
+	dependencies := map[string][]string{}
+	paths := map[string]string{}
+	for line := range strings.SplitSeq(string(data), "\n") {
+		module, deps, ok := strings.Cut(line, ":")
+		if ok {
+			dependencies[module] = strings.Fields(deps)
+			paths[strings.TrimSuffix(filepath.Base(module), ".ko")] = module
+		}
+	}
+	loaded := map[string]bool{}
+	var load func(string) error
+	load = func(path string) error {
+		if loaded[path] {
+			return nil
+		}
+		loaded[path] = true
+		for _, dep := range dependencies[path] {
+			if err := load(dep); err != nil {
+				return err
+			}
+		}
+		file, err := os.Open(filepath.Join(moduleDir, path))
+		if err != nil {
+			return err
+		}
+		defer file.Close() //nolint:errcheck
+		if err := unix.FinitModule(int(file.Fd()), "", 0); err != nil && !errors.Is(err, unix.EEXIST) {
+			return fmt.Errorf("load %s: %w", path, err)
+		}
+		return nil
+	}
+	for _, name := range []string{"xhci-hcd", "xhci-pci", "xhci-plat-hcd", "usb-storage", "uas"} {
+		path, ok := paths[name]
+		if !ok {
+			return fmt.Errorf("missing diagnostic storage module %s", name)
+		}
+		if err := load(path); err != nil {
+			return err
+		}
+	}
+
+	for attempt := 0; attempt < 20; attempt++ {
+		if _, err := os.Stat("/dev/sda1"); err == nil {
+			break
+		}
+		time.Sleep(250 * time.Millisecond)
+	}
+	const target = "/run/rpi5-boot-diagnostics"
+	if err := os.MkdirAll(target, 0o700); err != nil {
+		return err
+	}
+	flags := uintptr(unix.MS_NOSUID | unix.MS_NODEV | unix.MS_NOEXEC)
+	if err := unix.Mount("/dev/sda1", target, "vfat", flags|unix.MS_RDONLY, ""); err != nil {
+		return fmt.Errorf("mount diagnostic partition: %w", err)
+	}
+	defer unix.Unmount(target, unix.MNT_DETACH) //nolint:errcheck
+	marker, err := os.ReadFile(filepath.Join(target, "talos-test/cmdline.txt"))
+	if err != nil || !strings.Contains(" "+strings.TrimSpace(string(marker))+" ", " talos.rpi5.diag=1 ") {
+		return errors.New("partition does not contain the marked Talos test directory")
+	}
+	if err := unix.Mount("", target, "", flags|unix.MS_REMOUNT, ""); err != nil {
+		return err
+	}
+	buffer := make([]byte, 8*1024*1024)
+	n, err := unix.Klogctl(3, buffer)
+	if err != nil {
+		return err
+	}
+	path := filepath.Join(target, "talos-test", "boot-"+stage+".log")
+	if err := os.WriteFile(path, buffer[:n], 0o600); err != nil {
+		return err
+	}
+	unix.Sync()
+	log.Printf("saved Pi boot diagnostics: %s", path)
+	if stage == "initramfs" {
+		return startStream(target)
+	}
+	return nil
+}
+
+func startStream(target string) error {
+	kernel, err := os.OpenFile("/dev/kmsg", os.O_RDONLY|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return err
+	}
+	defer kernel.Close() //nolint:errcheck
+	output, err := os.OpenFile(filepath.Join(target, "talos-test/boot-stream.log"), os.O_CREATE|os.O_TRUNC|os.O_WRONLY|unix.O_SYNC, 0o600)
+	if err != nil {
+		return err
+	}
+	defer output.Close() //nolint:errcheck
+	cmdline, _ := os.ReadFile("/proc/cmdline")
+	seconds := 180
+	withWatchdog := false
+	for _, arg := range strings.Fields(string(cmdline)) {
+		if value, ok := strings.CutPrefix(arg, "talos.rpi5.test_timeout="); ok {
+			parsed, err := strconv.Atoi(value)
+			if err != nil || parsed < 60 || parsed > 1800 {
+				return errors.New("Pi diagnostic timeout must be 60..1800 seconds")
+			}
+			seconds = parsed
+			withWatchdog = true
+		}
+	}
+	command := exec.Command("/init", "--rpi5-logd", strconv.Itoa(seconds))
+	command.ExtraFiles = []*os.File{kernel, output}
+	var watchdog *os.File
+	if withWatchdog {
+		watchdog, err = os.OpenFile("/dev/watchdog0", os.O_WRONLY, 0)
+		if err == nil {
+			err = unix.IoctlSetPointerInt(int(watchdog.Fd()), unix.WDIOC_SETTIMEOUT, 15)
+		}
+		if err != nil {
+			if watchdog != nil {
+				_, _ = watchdog.WriteString("V")
+				_ = watchdog.Close()
+				watchdog = nil
+			}
+			log.Printf("Pi test watchdog unavailable: %v", err)
+		} else {
+			defer watchdog.Close() //nolint:errcheck
+			command.Args = append(command.Args, "watchdog")
+			command.ExtraFiles = append(command.ExtraFiles, watchdog)
+			log.Printf("Pi diagnostic boot will expire after %d seconds", seconds)
+		}
+	}
+	if err := command.Start(); err != nil {
+		if watchdog != nil {
+			_, _ = watchdog.WriteString("V")
+		}
+		return err
+	}
+	return nil
+}
+
+// Stream records messages using inherited descriptors, surviving the root switch.
+// It has a fixed lifetime and size limit and does not expose a shell or network service.
+func Stream(args []string) {
+	if len(args) < 1 {
+		return
+	}
+	seconds, err := strconv.Atoi(args[0])
+	if err != nil || seconds < 60 || seconds > 1800 {
+		return
+	}
+	withWatchdog := len(args) == 2 && args[1] == "watchdog"
+	// exec may clear O_NONBLOCK while duplicating inherited descriptors.
+	if err := unix.SetNonblock(3, true); err != nil {
+		return
+	}
+	output := os.NewFile(4, "boot-stream.log")
+	defer output.Close() //nolint:errcheck
+	defer unix.Close(3)  //nolint:errcheck
+	var watchdog *os.File
+	if withWatchdog {
+		watchdog = os.NewFile(5, "watchdog")
+		// No magic close: expiration intentionally resets this one-time test.
+		defer watchdog.Close() //nolint:errcheck
+	}
+	buffer := make([]byte, 65536)
+	deadline := time.Now().Add(time.Duration(seconds) * time.Second)
+	nextFeed := time.Now()
+	written := 0
+	logging := true
+	for time.Now().Before(deadline) {
+		if watchdog != nil && !time.Now().Before(nextFeed) {
+			if _, err := watchdog.WriteString("K"); err != nil {
+				return
+			}
+			nextFeed = time.Now().Add(2 * time.Second)
+		}
+		if !logging || written >= 16*1024*1024 {
+			if watchdog == nil {
+				return
+			}
+			time.Sleep(100 * time.Millisecond)
+			continue
+		}
+		n, err := unix.Read(3, buffer)
+		if errors.Is(err, unix.EAGAIN) || errors.Is(err, unix.EPIPE) || errors.Is(err, unix.EINTR) {
+			time.Sleep(20 * time.Millisecond)
+			continue
+		}
+		if err != nil || n == 0 {
+			logging = false
+			continue
+		}
+		count, err := output.Write(buffer[:n])
+		written += count
+		if err != nil {
+			logging = false
+		}
+	}
+}
