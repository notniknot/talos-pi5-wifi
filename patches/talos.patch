+package rpi5
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestTrialCommitAndExplicitRollback(t *testing.T) {
+	b, opts := fixture(t)
+	root := t.TempDir()
+	require.NoError(t, b.installSlots(root, opts))
+	original, err := os.ReadFile(filepath.Join(root, "config.txt"))
+	require.NoError(t, err)
+	previous, err := b.upgradeSlots(root, opts, "A")
+	require.NoError(t, err)
+	require.Equal(t, "A", previous)
+	after, err := os.ReadFile(filepath.Join(root, "config.txt"))
+	require.NoError(t, err)
+	require.Equal(t, original, after)
+	p, err := readPending(root)
+	require.NoError(t, err)
+	require.Equal(t, &pending{Slot: "B", Previous: "A"}, p)
+	require.Error(t, finishBoot(root, "B", false)) // a command-line slot alone cannot authorize promotion
+	require.NoError(t, finishBoot(root, "B", true))
+	active, err := activeSlot(root)
+	require.NoError(t, err)
+	require.Equal(t, "B", active)
+	p, err = readPending(root)
+	require.NoError(t, err)
+	require.Nil(t, p)
+	require.NoError(t, revertSlots(root, "B"))
+	active, err = activeSlot(root)
+	require.NoError(t, err)
+	require.Equal(t, "B", active) // rollback is itself a trial
+	require.NoError(t, finishBoot(root, "A", true))
+	active, err = activeSlot(root)
+	require.NoError(t, err)
+	require.Equal(t, "A", active)
+}
+
+func TestFailedTrialReturnsToUnchangedDefault(t *testing.T) {
+	b, opts := fixture(t)
+	root := t.TempDir()
+	require.NoError(t, b.installSlots(root, opts))
+	_, err := b.upgradeSlots(root, opts, "A")
+	require.NoError(t, err)
+	// Firmware cleared its one-shot bit before booting B. Any reset now boots A.
+	require.NoError(t, finishBoot(root, "A", false))
+	p, err := readPending(root)
+	require.NoError(t, err)
+	require.Nil(t, p)
+	active, err := activeSlot(root)
+	require.NoError(t, err)
+	require.Equal(t, "A", active)
+	require.NoError(t, verifySlot(root, "A"))
+	_, err = b.upgradeSlots(root, opts, "A")
+	require.NoError(t, err)                    // a failed trial does not block future upgrades
+	require.NoError(t, revertSlots(root, "B")) // machined's fatal-error rollback cancels the candidate
+	active, err = activeSlot(root)
+	require.NoError(t, err)
+	require.Equal(t, "A", active)
+}
+
+func TestInterruptedCommitIsRecoverable(t *testing.T) {
+	for _, promoted := range []bool{false, true} {
+		t.Run(map[bool]string{false: "before-config", true: "after-config"}[promoted], func(t *testing.T) {
+			b, opts := fixture(t)
+			root := t.TempDir()
+			require.NoError(t, b.installSlots(root, opts))
+			_, err := b.upgradeSlots(root, opts, "A")
+			require.NoError(t, err)
+			require.NoError(t, atomicWrite(filepath.Join(root, "previous.txt"), configFor("A", false)))
+			running := "A"
+			if promoted {
+				require.NoError(t, atomicWrite(filepath.Join(root, "config.txt"), configFor("B", false)))
+				running = "B"
+			}
+			require.NoError(t, finishBoot(root, running, false))
+			active, err := activeSlot(root)
+			require.NoError(t, err)
+			require.Equal(t, running, active)
+			p, err := readPending(root)
+			require.NoError(t, err)
+			require.Nil(t, p)
+		})
+	}
+}
+
+func TestUnsafeUpgradeLeavesCommittedSlotUntouched(t *testing.T) {
+	b, opts := fixture(t)
+	root := t.TempDir()
+	require.NoError(t, b.installSlots(root, opts))
+	_, err := b.upgradeSlots(root, opts, "B")
+	require.Error(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(b.AssetsDir, "Image"), []byte("broken"), 0600))
+	_, err = b.upgradeSlots(root, opts, "A")
+	require.Error(t, err)
+	require.NoError(t, verifySlot(root, "A"))
+	active, err := activeSlot(root)
+	require.NoError(t, err)
+	require.Equal(t, "A", active)
+	p, err := readPending(root)
+	require.NoError(t, err)
+	require.Nil(t, p)
+}
+
+func TestCorruptCandidateAndConcurrentUpgradeAreRejected(t *testing.T) {
+	b, opts := fixture(t)
+	root := t.TempDir()
+	require.NoError(t, b.installSlots(root, opts))
+	_, err := b.upgradeSlots(root, opts, "A")
+	require.NoError(t, err)
+	_, err = b.upgradeSlots(root, opts, "A")
+	require.ErrorContains(t, err, "already pending")
+	require.NoError(t, os.WriteFile(filepath.Join(slotPath(root, "B"), "initramfs.xz"), []byte("torn write"), 0600))
+	require.ErrorContains(t, finishBoot(root, "B", true), "checksum mismatch")
+	active, err := activeSlot(root)
+	require.NoError(t, err)
+	require.Equal(t, "A", active)
+	require.NoError(t, verifySlot(root, "A"))
+}
+
+func TestMetadataCannotSelectPathsOutsideSlots(t *testing.T) {
+	_, err := configSlot([]byte("kernel=../Image\n"))
+	require.Error(t, err)
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(root, pendingName), []byte(`{"slot":"../../STATE","previous":"A"}`), 0600))
+	_, err = readPending(root)
+	require.Error(t, err)
+}
+
+func TestTrialWatchdogIsNotEnabledOnNormalBoot(t *testing.T) {
+	require.Contains(t, string(configFor("B", true)), "kernel_watchdog_timeout=600")
+	require.NotContains(t, string(configFor("B", false)), "kernel_watchdog_timeout")
+	b, opts := fixture(t)
+	root := t.TempDir()
+	require.NoError(t, b.installSlots(root, opts))
+	data, err := os.ReadFile(filepath.Join(slotPath(root, "A"), "cmdline.txt"))
+	require.NoError(t, err)
+	require.Contains(t, string(data), "watchdog.open_timeout=600")
+	require.Contains(t, string(data), "talos.rpi5.slot=A")
+	require.Contains(t, string(data), "panic=10")
+}
