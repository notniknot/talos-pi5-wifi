+	// The wireless regulatory domain is global to the kernel, so all WifiConfig documents must agree
+	// on the country code. A per-document Validate() cannot see the other documents, so this is a
+	// container-level check.
+	var wifiCountryCode string
+
+	for _, wifiConfig := range container.NetworkWifiConfigs() {
+		switch countryCode := wifiConfig.CountryCode(); {
+		case countryCode == "":
+		case wifiCountryCode == "":
+			wifiCountryCode = countryCode
+		case countryCode != wifiCountryCode:
+			errs = multierror.Append(errs, fmt.Errorf("all WifiConfig documents must use the same country code: %q vs. %q", wifiCountryCode, countryCode))
+		}
+	}
+
 	// machine type specific checks
 	var machineType machine.Type
 
diff --git a/pkg/machinery/config/container/wifi_test.go b/pkg/machinery/config/container/wifi_test.go
new file mode 100644
index 0000000..722fa69
--- /dev/null
+++ b/pkg/machinery/config/container/wifi_test.go
@@ -0,0 +1,35 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package container_test
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/siderolabs/talos/pkg/machinery/config/container"
+	"github.com/siderolabs/talos/pkg/machinery/config/types/network"
+)
+
+func TestWifiCountryConsistency(t *testing.T) {
+	for _, country := range []string{"NL", "", "DE"} {
+		t.Run(country, func(t *testing.T) {
+			first := network.NewWifiConfigV1Alpha1("wlan0")
+			first.WifiCountryCode = "NL"
+			first.WifiNetworks = []network.WifiNetworkConfig{{WifiSSID: "Example"}}
+			second := network.NewWifiConfigV1Alpha1("wlan1")
+			second.WifiCountryCode = country
+			second.WifiNetworks = []network.WifiNetworkConfig{{WifiSSID: "Example"}}
+			config, err := container.New(first, second)
+			require.NoError(t, err)
+			_, err = config.ValidateAsClient(validationMode{})
+			if country == "DE" {
+				require.ErrorContains(t, err, "all WifiConfig documents must use the same country code")
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
