+
+	"github.com/siderolabs/talos/internal/app/machined/pkg/runtime"
+	"github.com/siderolabs/talos/internal/app/machined/pkg/runtime/v1alpha1/bootloader/mount"
+	"github.com/siderolabs/talos/internal/app/machined/pkg/runtime/v1alpha1/bootloader/options"
+	mountv3 "github.com/siderolabs/talos/internal/pkg/mount/v3"
+	"github.com/siderolabs/talos/internal/pkg/partition"
+	"github.com/siderolabs/talos/pkg/machinery/constants"
+)
+
+const (
+	// AssetsPath exists only in the dedicated Pi 5 installer image.
+	AssetsPath  = "/usr/install/rpi5"
+	markerName  = "talos-rpi5-direct"
+	markerValue = "raspberrypi5-d0-direct-v1\n"
+	bootConfig  = "arm_64bit=1\narm_boost=1\ngpu_mem=32\nauto_initramfs=0\nenable_uart=0\nusb_max_current_enable=1\nkernel=Image\ninitramfs initramfs.xz followkernel\ncmdline=cmdline.txt\ndevice_tree=bcm2712d0-rpi-5-b.dtb\noverlay_prefix=overlays/\ndtoverlay=disable-v3d\n"
+)
+
+// Bootloader manages firmware one-shot trials of two complete boot-image slots.
+type Bootloader struct {
+	AssetsDir string
+	Layout    string
+}
+
+// New returns a bootloader for the dedicated installer image.
+func New() *Bootloader { return &Bootloader{AssetsDir: AssetsPath, Layout: abMarkerValue} }
+
+// InstallerPresent identifies the dedicated image without changing other installers.
+func InstallerPresent() bool {
+	data, err := os.ReadFile(filepath.Join(AssetsPath, markerName))
+	return err == nil && string(data) == markerValue
+}
+
+// PrepareBootPartitions validates every boot asset before the installer wipes a disk.
+func (b *Bootloader) PrepareBootPartitions(opts options.InstallOptions) ([]partition.Options, error) {
+	if opts.ImageMode || opts.Arch != "arm64" {
+		return nil, errors.New("Pi 5 direct boot requires an arm64 installation, not image mode")
+	}
+	if err := b.validateAssets(opts); err != nil {
+		return nil, err
+	}
+	return []partition.Options{{
+		FormatOptions:  *partition.NewFormatOptions(partition.WithLabel(constants.EFIPartitionLabel)),
+		PartitionLabel: constants.EFIPartitionLabel,
+		PartitionType:  partition.EFISystemPartition,
+		Size:           1024 * 1024 * 1024,
+	}}, nil
+}
+
+func checkHeader(path string, offset int64, magic []byte) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close() //nolint:errcheck
+	actual := make([]byte, len(magic))
+	if _, err = f.ReadAt(actual, offset); err != nil {
+		return err
+	}
+	if !bytes.Equal(actual, magic) {
+		return fmt.Errorf("invalid boot asset header: %s", path)
+	}
+	return nil
+}
+
+func (b *Bootloader) validateAssets(opts options.InstallOptions) error {
+	for _, asset := range []struct {
+		path   string
+		offset int64
+		magic  []byte
+	}{
+		{filepath.Join(b.AssetsDir, "Image"), 56, []byte{'A', 'R', 'M', 0x64}},
+		{opts.BootAssets.InitramfsPath, 0, []byte{0x28, 0xb5, 0x2f, 0xfd}},
+		{filepath.Join(b.AssetsDir, "bcm2712d0-rpi-5-b.dtb"), 0, []byte{0xd0, 0x0d, 0xfe, 0xed}},
+		{filepath.Join(b.AssetsDir, "overlays/disable-v3d.dtbo"), 0, []byte{0xd0, 0x0d, 0xfe, 0xed}},
+	} {
+		if err := checkHeader(asset.path, asset.offset, asset.magic); err != nil {
+			return err
+		}
+	}
+	if strings.ContainsAny(opts.Cmdline, "\r\n") {
+		return errors.New("multiline Pi boot command line")
+	}
+	return nil
+}
+
+func copySynced(src, dst string) error {
+	in, err := os.Open(src)
+	if err != nil {
+		return err
+	}
+	defer in.Close() //nolint:errcheck
+	out, err := os.OpenFile(dst, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0o644)
+	if err != nil {
+		return err
+	}
+	_, copyErr := io.Copy(out, in)
+	syncErr := out.Sync()
+	closeErr := out.Close()
+	return errors.Join(copyErr, syncErr, closeErr)
+}
+
+func (b *Bootloader) writeAssets(target string, opts options.InstallOptions) error {
+	if err := b.validateAssets(opts); err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Join(target, "overlays"), 0o755); err != nil {
+		return err
+	}
+	for _, name := range []string{"Image", "bcm2712d0-rpi-5-b.dtb", "overlays/disable-v3d.dtbo"} {
+		if err := copySynced(filepath.Join(b.AssetsDir, name), filepath.Join(target, name)); err != nil {
+			return err
+		}
+	}
+	if err := copySynced(opts.BootAssets.InitramfsPath, filepath.Join(target, "initramfs.xz")); err != nil {
+		return err
+	}
+	args := []string{}
+	for _, arg := range strings.Fields(opts.Cmdline) {
+		if strings.HasPrefix(arg, "watchdog.open_timeout=") || strings.HasPrefix(arg, "panic=") || strings.HasPrefix(arg, "talos.rpi5.") || strings.HasPrefix(arg, "net.ifnames=") || strings.HasPrefix(arg, "console=") || strings.HasPrefix(arg, "sysctl.kernel.kexec_load_disabled=") {
+			continue
+		}
+		args = append(args, arg)
+	}
+	args = append(args, "console=tty0", "net.ifnames=0", "sysctl.kernel.kexec_load_disabled=1", "talos.dashboard.disabled=1", "talos.rpi5.direct=1", "talos.rpi5.wifi_no_ps=1")
+	for name, value := range map[string]string{
+		"cmdline.txt": strings.Join(args, " ") + "\n",
+		markerName:    markerValue,
+	} {
+		if err := os.WriteFile(filepath.Join(target, name), []byte(value), 0o644); err != nil {
+			return err
+		}
+	}
+	// The firmware entrypoint is written last. This is an initial install only.
+	return os.WriteFile(filepath.Join(target, "config.txt"), []byte(bootConfig), 0o644)
+}
+
+// Install writes the verified raw kernel and initramfs to the FAT boot partition.
+func (b *Bootloader) Install(opts options.InstallOptions) (*options.InstallResult, error) {
+	target := filepath.Join(opts.MountPrefix, constants.EFIMountPoint)
+	err := mount.PartitionOp(opts.BootDisk, []mount.Spec{{
+		PartitionLabel: constants.EFIPartitionLabel, FilesystemType: partition.FilesystemTypeVFAT, MountTarget: target,
+	}}, func() error { return b.installSlots(target, opts) }, []blkid.ProbeOption{blkid.WithSkipLocking(true)}, nil, nil, opts.BlkidInfo)
+	if err != nil {
+		return nil, err
+	}
+	return &options.InstallResult{}, nil
+}
+
+// Probe recognizes only an installation with our exact format marker.
+func Probe(disk string, opts options.ProbeOptions) (*Bootloader, error) {
+	var layout string
+	err := mount.PartitionOp(disk, []mount.Spec{{
+		PartitionLabel: constants.EFIPartitionLabel, FilesystemType: partition.FilesystemTypeVFAT, MountTarget: constants.EFIMountPoint,
+	}}, func() error {
+		data, err := os.ReadFile(filepath.Join(constants.EFIMountPoint, markerName))
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if string(data) == markerValue || string(data) == abMarkerValue {
+			layout = string(data)
+		}
+		return nil
+	}, opts.BlockProbeOptions, []mountv3.ManagerOption{mountv3.WithSkipIfMounted(), mountv3.WithReadOnly()}, nil, nil)
+	if xerrors.TagIs[mount.NotFoundTag](err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if layout == "" {
+		return nil, nil
+	}
+	b := New()
+	b.Layout = layout
+	return b, nil
+}
+
+// KexecLoad is disabled because the Pi firmware must initialize the hardware.
+func (b *Bootloader) KexecLoad(runtime.Runtime, string) error {
+	return errors.New("Pi 5 direct boot requires a firmware reboot")
+}
