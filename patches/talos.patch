+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package services
+
+import (
+	"fmt"
+	"log"
+	"net"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/mdlayher/genetlink"
+	"github.com/mdlayher/netlink"
+	"golang.org/x/sys/unix"
+)
+
+// disablePiWiFiPowerSave is an opt-in experiment for Broadcom SDIO reliability.
+// Keep the default unchanged until extended hardware testing establishes a fix.
+func disablePiWiFiPowerSave(name string) error {
+	cmdline, err := os.ReadFile("/proc/cmdline")
+	if err != nil {
+		return err
+	}
+	if !strings.Contains(" "+strings.TrimSpace(string(cmdline))+" ", " talos.rpi5.wifi_no_ps=1 ") {
+		return nil
+	}
+	iface, err := net.InterfaceByName(name)
+	if err != nil {
+		return err
+	}
+	conn, err := genetlink.Dial(nil)
+	if err != nil {
+		return err
+	}
+	defer conn.Close() //nolint:errcheck
+	if err = conn.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		return err
+	}
+	family, err := conn.GetFamily("nl80211")
+	if err != nil {
+		return err
+	}
+	encoder := netlink.NewAttributeEncoder()
+	encoder.Uint32(unix.NL80211_ATTR_IFINDEX, uint32(iface.Index))
+	encoder.Uint32(unix.NL80211_ATTR_PS_STATE, unix.NL80211_PS_DISABLED)
+	data, err := encoder.Encode()
+	if err != nil {
+		return err
+	}
+	_, err = conn.Execute(genetlink.Message{Header: genetlink.Header{Command: unix.NL80211_CMD_SET_POWER_SAVE, Version: family.Version}, Data: data}, family.ID, netlink.Request|netlink.Acknowledge)
+	if err != nil {
+		return fmt.Errorf("disable Wi-Fi power saving on %s: %w", name, err)
+	}
+	log.Printf("Pi Wi-Fi experiment: disabled power saving on %s", name)
+	return nil
+}
