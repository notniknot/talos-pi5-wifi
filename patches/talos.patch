+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package rpi5
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/siderolabs/talos/internal/app/machined/pkg/runtime/v1alpha1/bootloader/options"
+	"github.com/siderolabs/talos/internal/pkg/partition"
+)
+
+func fixture(t *testing.T) (*Bootloader, options.InstallOptions) {
+	t.Helper()
+	dir := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(dir, "overlays"), 0o755))
+	kernel := make([]byte, 64)
+	copy(kernel[56:], []byte{'A', 'R', 'M', 0x64})
+	for name, data := range map[string][]byte{
+		"Image":                     kernel,
+		"bcm2712d0-rpi-5-b.dtb":     {0xd0, 0x0d, 0xfe, 0xed},
+		"overlays/disable-v3d.dtbo": {0xd0, 0x0d, 0xfe, 0xed},
+		"initramfs.xz":              {0x28, 0xb5, 0x2f, 0xfd},
+	} {
+		require.NoError(t, os.WriteFile(filepath.Join(dir, name), data, 0o600))
+	}
+	return &Bootloader{AssetsDir: dir}, options.InstallOptions{
+		Arch: "arm64", Cmdline: "talos.platform=metal pti=on module.sig_enforce=1 talos.rpi5.diag=1 talos.rpi5.test_timeout=180 net.ifnames=1",
+		BootAssets: options.BootAssets{InitramfsPath: filepath.Join(dir, "initramfs.xz")},
+	}
+}
+
+func TestRejectUnsafeAssetsBeforePartitioning(t *testing.T) {
+	for _, name := range []string{"Image", "initramfs.xz", "bcm2712d0-rpi-5-b.dtb", "overlays/disable-v3d.dtbo"} {
+		t.Run(name, func(t *testing.T) {
+			b, opts := fixture(t)
+			require.NoError(t, os.WriteFile(filepath.Join(b.AssetsDir, name), []byte("invalid"), 0o600))
+			parts, err := b.PrepareBootPartitions(opts)
+			require.Error(t, err)
+			require.Nil(t, parts)
+		})
+	}
+	for _, mutate := range []func(*options.InstallOptions){
+		func(o *options.InstallOptions) { o.Arch = "amd64" },
+		func(o *options.InstallOptions) { o.ImageMode = true },
+		func(o *options.InstallOptions) { o.Cmdline = "console=tty0\ninvalid" },
+	} {
+		b, opts := fixture(t)
+		mutate(&opts)
+		parts, err := b.PrepareBootPartitions(opts)
+		require.Error(t, err)
+		require.Nil(t, parts)
+	}
+}
+
+func TestFirmwareBootContract(t *testing.T) {
+	b, opts := fixture(t)
+	parts, err := b.PrepareBootPartitions(opts)
+	require.NoError(t, err)
+	require.Len(t, parts, 1)
+	require.Equal(t, partition.FilesystemTypeVFAT, parts[0].FileSystemType)
+	require.GreaterOrEqual(t, parts[0].Size, uint64(512*1024*1024))
+	dst := t.TempDir()
+	require.NoError(t, b.writeAssets(dst, opts))
+	cmdline, err := os.ReadFile(filepath.Join(dst, "cmdline.txt"))
+	require.NoError(t, err)
+	for _, arg := range []string{"talos.platform=metal", "pti=on", "module.sig_enforce=1", "net.ifnames=0", "sysctl.kernel.kexec_load_disabled=1"} {
+		require.Contains(t, strings.Fields(string(cmdline)), arg)
+	}
+	require.NotContains(t, string(cmdline), "talos.rpi5.diag")
+	require.NotContains(t, string(cmdline), "test_timeout")
+	require.NotContains(t, string(cmdline), "net.ifnames=1")
+	config, err := os.ReadFile(filepath.Join(dst, "config.txt"))
+	require.NoError(t, err)
+	for _, line := range []string{"kernel=Image", "initramfs initramfs.xz followkernel", "device_tree=bcm2712d0-rpi-5-b.dtb", "dtoverlay=disable-v3d"} {
+		require.Contains(t, string(config), line)
+	}
+	for _, name := range []string{"Image", "initramfs.xz", "bcm2712d0-rpi-5-b.dtb", "overlays/disable-v3d.dtbo"} {
+		src, err := os.ReadFile(filepath.Join(b.AssetsDir, name))
+		require.NoError(t, err)
+		copied, err := os.ReadFile(filepath.Join(dst, name))
+		require.NoError(t, err)
+		require.Equal(t, src, copied)
+	}
+}
diff --git a/internal/app/machined/pkg/runtime/v1alpha1/bootloader/rpi5/runtime.go b/internal/app/machined/pkg/runtime/v1alpha1/bootloader/rpi5/runtime.go
new file mode 100644
index 0000000..5d1accc
--- /dev/null
+++ b/internal/app/machined/pkg/runtime/v1alpha1/bootloader/rpi5/runtime.go
@@ -0,0 +1,160 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package rpi5
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"os"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"unsafe"
+
+	"github.com/siderolabs/talos/pkg/machinery/constants"
+	"golang.org/x/sys/unix"
+)
+
+var trybootRequested atomic.Bool
+var confirmed = make(chan struct{})
+var confirmOnce sync.Once
+
+// AwaitConfirmation reserves the boot watchdog until the trial is committed.
+func AwaitConfirmation(ctx context.Context) error {
+	if !Enabled() {
+		return nil
+	}
+	trial, err := isTrial()
+	if err != nil {
+		return err
+	}
+	if !trial {
+		return nil
+	}
+	select {
+	case <-confirmed:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func cmdlineValue(key string) string {
+	data, err := os.ReadFile("/proc/cmdline")
+	if err != nil {
+		return ""
+	}
+	for _, arg := range strings.Fields(string(data)) {
+		if v, ok := strings.CutPrefix(arg, key+"="); ok {
+			return v
+		}
+	}
+	return ""
+}
+
+// Enabled identifies the running OS, not just an installer carrying new code.
+func Enabled() bool { return cmdlineValue("talos.rpi5.ab") == "1" }
+
+// RunningSlot identifies the image the firmware actually loaded.
+func RunningSlot() string { return cmdlineValue("talos.rpi5.slot") }
+func isTrial() (bool, error) {
+	data, err := os.ReadFile("/proc/device-tree/chosen/bootloader/tryboot")
+	if err != nil {
+		return false, err
+	}
+	if len(data) != 4 {
+		return false, errors.New("invalid firmware tryboot property")
+	}
+	return binary.BigEndian.Uint32(data) == 1, nil
+}
+
+// PrepareReboot only arms a staged image different from the running image. A
+// failed candidate must always use a normal reboot and the untouched fallback.
+func PrepareReboot(disk string) error {
+	trybootRequested.Store(false)
+	if !Enabled() {
+		return nil
+	}
+	return partitionOp(disk, constants.EFIMountPoint, func() error {
+		p, err := readPending(constants.EFIMountPoint)
+		if err != nil {
+			return err
+		}
+		if p == nil || p.Slot == RunningSlot() {
+			return nil
+		}
+		active, err := activeSlot(constants.EFIMountPoint)
+		if err != nil {
+			return err
+		}
+		if active != RunningSlot() || p.Previous != active {
+			return errors.New("cannot arm mismatched Pi trial")
+		}
+		if err = verifySlot(constants.EFIMountPoint, p.Slot); err != nil {
+			return err
+		}
+		cfg, err := os.ReadFile(constants.EFIMountPoint + "/tryboot.txt")
+		if err != nil {
+			return err
+		}
+		if string(cfg) != string(configFor(p.Slot, true)) {
+			return errors.New("invalid tryboot configuration")
+		}
+		trybootRequested.Store(true)
+		return nil
+	}, nil)
+}
+
+// Restart performs the firmware reboot after Talos has flushed and unmounted.
+func Restart(cmd int, normal bool) error {
+	if cmd != unix.LINUX_REBOOT_CMD_RESTART || !normal || !trybootRequested.Load() {
+		return unix.Reboot(cmd)
+	}
+	arg, err := unix.BytePtrFromString("0 tryboot")
+	if err != nil {
+		return err
+	}
+	_, _, errno := unix.Syscall6(unix.SYS_REBOOT, unix.LINUX_REBOOT_MAGIC1, unix.LINUX_REBOOT_MAGIC2, unix.LINUX_REBOOT_CMD_RESTART2, uintptr(unsafe.Pointer(arg)), 0, 0)
+	runtime.KeepAlive(arg)
+	if errno != 0 {
+		return errno
+	}
+	return nil
+}
+
+// ConfirmBoot is called only after Talos is running and Ready, including time,
+// network, services, static control-plane pods and Kubernetes node readiness.
+func ConfirmBoot(disk string) error {
+	if !Enabled() {
+		return nil
+	}
+	trial, err := isTrial()
+	if err != nil {
+		return err
+	}
+	if err = partitionOp(disk, constants.EFIMountPoint, func() error { return finishBoot(constants.EFIMountPoint, RunningSlot(), trial) }, nil); err != nil {
+		return err
+	}
+	if !trial {
+		return nil
+	}
+	// The firmware starts the watchdog; the kernel feeds it for at most
+	// watchdog.open_timeout=600 seconds. Do not open/feed it during boot: a hung
+	// or unhealthy OS must time out even if machined never starts. Disarm only
+	// after the committed config is durable. No other service may own this device.
+	wd, err := os.OpenFile("/dev/watchdog0", os.O_WRONLY, 0)
+	if err != nil {
+		return fmt.Errorf("opening boot watchdog: %w", err)
+	}
+	_, err = wd.WriteString("V")
+	if err = errors.Join(err, wd.Close()); err != nil {
+		return err
+	}
+	confirmOnce.Do(func() { close(confirmed) })
+	return nil
+}
diff --git a/internal/app/machined/pkg/runtime/v1alpha1/bootloader/rpi5/slots.go b/internal/app/machined/pkg/runtime/v1alpha1/bootloader/rpi5/slots.go
new file mode 100644
index 0000000..e1cc0f2
--- /dev/null
+++ b/internal/app/machined/pkg/runtime/v1alpha1/bootloader/rpi5/slots.go
@@ -0,0 +1,364 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package rpi5
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/siderolabs/go-blockdevice/v2/blkid"
+	"github.com/siderolabs/talos/internal/app/machined/pkg/runtime/v1alpha1/bootloader/mount"
+	"github.com/siderolabs/talos/internal/app/machined/pkg/runtime/v1alpha1/bootloader/options"
+	"github.com/siderolabs/talos/internal/pkg/partition"
+	"github.com/siderolabs/talos/pkg/machinery/constants"
+)
+
+const abMarkerValue = "raspberrypi5-d0-tryboot-v2\n"
+const pendingName = "talos-pending.json"
+
+var slotAssets = []string{"Image", "initramfs.xz", "bcm2712d0-rpi-5-b.dtb", "overlays/disable-v3d.dtbo", "cmdline.txt"}
+
+type pending struct {
+	Slot     string `json:"slot"`
+	Previous string `json:"previous"`
+}
+
+func validSlot(s string) bool           { return s == "A" || s == "B" }
+func slotPath(root, slot string) string { return filepath.Join(root, "talos", slot) }
+
+// atomicWrite persists contents before changing the directory entry. The two
+// image slots still share FAT metadata; this cannot protect against media damage.
+func atomicWrite(path string, data []byte) error {
+	f, err := os.CreateTemp(filepath.Dir(path), ".talos-write-")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name) //nolint:errcheck
+	_, we := f.Write(data)
+	se := f.Sync()
+	ce := f.Close()
+	if err = errors.Join(we, se, ce); err != nil {
+		return err
+	}
+	if err = os.Rename(name, path); err != nil {
+		return err
+	}
+	d, err := os.Open(filepath.Dir(path))
+	if err != nil {
+		return err
+	}
+	defer d.Close() //nolint:errcheck
+	return d.Sync()
+}
+
+func removeSynced(path string) error {
+	if err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	d, err := os.Open(filepath.Dir(path))
+	if err != nil {
+		return err
+	}
+	defer d.Close() //nolint:errcheck
+	return d.Sync()
+}
+
+func configFor(slot string, trial bool) []byte {
+	prefix := "talos/" + slot + "/"
+	cfg := bootConfig
+	for _, pair := range [][2]string{{"kernel=Image", "kernel=" + prefix + "Image"}, {"initramfs initramfs.xz", "initramfs " + prefix + "initramfs.xz"}, {"cmdline=cmdline.txt", "cmdline=" + prefix + "cmdline.txt"}, {"device_tree=bcm2712d0-rpi-5-b.dtb", "device_tree=" + prefix + "bcm2712d0-rpi-5-b.dtb"}, {"overlay_prefix=overlays/", "overlay_prefix=" + prefix + "overlays/"}} {
+		cfg = strings.ReplaceAll(cfg, pair[0], pair[1])
+	}
+	if trial {
+		cfg += "kernel_watchdog_timeout=600\nkernel_watchdog_partition=0\n"
+	}
+	return []byte(cfg)
+}
+
+func configSlot(data []byte) (string, error) {
+	for _, s := range []string{"A", "B"} {
+		if string(data) == string(configFor(s, false)) {
+			return s, nil
+		}
+	}
+	return "", errors.New("unrecognized Pi A/B config; refusing to overwrite manual firmware settings")
+}
+func activeSlot(root string) (string, error) {
+	data, err := os.ReadFile(filepath.Join(root, "config.txt"))
+	if err != nil {
+		return "", err
+	}
+	return configSlot(data)
+}
+func readPending(root string) (*pending, error) {
+	data, err := os.ReadFile(filepath.Join(root, pendingName))
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var p pending
+	if err = json.Unmarshal(data, &p); err != nil {
+		return nil, err
+	}
+	if !validSlot(p.Slot) || !validSlot(p.Previous) || p.Slot == p.Previous {
+		return nil, errors.New("invalid Pi trial metadata")
+	}
+	return &p, nil
+}
+func hashFile(path string) (string, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+	h := sha256.New()
+	if _, err = io.Copy(h, f); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
+func writeManifest(root string) error {
+	m := map[string]string{}
+	for _, name := range slotAssets {
+		h, err := hashFile(filepath.Join(root, name))
+		if err != nil {
+			return err
+		}
+		m[name] = h
+	}
+	data, err := json.Marshal(m)
+	if err != nil {
+		return err
+	}
+	return atomicWrite(filepath.Join(root, "manifest.json"), data)
+}
+func verifySlot(root, slot string) error {
+	if !validSlot(slot) {
+		return errors.New("invalid slot")
+	}
+	dir := slotPath(root, slot)
+	data, err := os.ReadFile(filepath.Join(dir, "manifest.json"))
+	if err != nil {
+		return err
+	}
+	var m map[string]string
+	if err = json.Unmarshal(data, &m); err != nil {
+		return err
+	}
+	if len(m) != len(slotAssets) {
+		return errors.New("incomplete slot manifest")
+	}
+	for _, name := range slotAssets {
+		h, err := hashFile(filepath.Join(dir, name))
+		if err != nil {
+			return err
+		}
+		if h != m[name] {
+			return fmt.Errorf("slot %s checksum mismatch: %s", slot, name)
+		}
+	}
+	return nil
+}
+func (b *Bootloader) writeSlot(root, slot string, opts options.InstallOptions) error {
+	dir := slotPath(root, slot)
+	if err := os.MkdirAll(filepath.Dir(dir), 0755); err != nil {
+		return err
+	}
+	// This slot is never the committed or running one. A failed write leaves the
+	// current slot and config.txt untouched; no partial slot is made pending.
+	if err := os.RemoveAll(dir); err != nil {
+		return err
+	}
+	if err := b.writeAssets(dir, opts); err != nil {
+		return err
+	}
+	data, err := os.ReadFile(filepath.Join(dir, "cmdline.txt"))
+	if err != nil {
+		return err
+	}
+	args := strings.Fields(string(data))
+	args = append(args, "talos.rpi5.ab=1", "talos.rpi5.slot="+slot, "watchdog.open_timeout=600", "panic=10")
+	if err = atomicWrite(filepath.Join(dir, "cmdline.txt"), []byte(strings.Join(args, " ")+"\n")); err != nil {
+		return err
+	}
+	if err = writeManifest(dir); err != nil {
+		return err
+	}
+	return verifySlot(root, slot)
+}
+func (b *Bootloader) installSlots(root string, opts options.InstallOptions) error {
+	if err := b.writeSlot(root, "A", opts); err != nil {
+		return err
+	}
+	if err := atomicWrite(filepath.Join(root, markerName), []byte(abMarkerValue)); err != nil {
+		return err
+	}
+	return atomicWrite(filepath.Join(root, "config.txt"), configFor("A", false))
+}
+
+// CheckUpgrade is called before the installer performs any disk operations.
+func (b *Bootloader) CheckUpgrade() error {
+	if b.Layout != abMarkerValue {
+		return errors.New("legacy Pi boot layout requires the documented one-time A/B migration; refusing before disk changes")
+	}
+	if !Enabled() {
+		return errors.New("running OS lacks Pi A/B upgrade support; refusing before disk changes")
+	}
+	return nil
+}
+func stage(root, next, current string) error {
+	if err := verifySlot(root, next); err != nil {
+		return err
+	}
+	if err := atomicWrite(filepath.Join(root, "tryboot.txt"), configFor(next, true)); err != nil {
+		return err
+	}
+	data, err := json.Marshal(pending{Slot: next, Previous: current})
+	if err != nil {
+		return err
+	}
+	return atomicWrite(filepath.Join(root, pendingName), data)
+}
+func (b *Bootloader) upgradeSlots(root string, opts options.InstallOptions, running string) (string, error) {
+	if err := b.validateAssets(opts); err != nil {
+		return "", err
+	}
+	current, err := activeSlot(root)
+	if err != nil {
+		return "", err
+	}
+	if running != current {
+		return "", errors.New("cannot upgrade an uncommitted or mismatched running slot")
+	}
+	p, err := readPending(root)
+	if err != nil {
+		return "", err
+	}
+	if p != nil {
+		return "", errors.New("a Pi boot trial is already pending")
+	}
+	if err = verifySlot(root, current); err != nil {
+		return "", err
+	}
+	next := "A"
+	if current == "A" {
+		next = "B"
+	}
+	// A two-slot update consumes the older rollback slot. Never leave a rollback
+	// selector pointing at files that are about to be replaced.
+	if err = removeSynced(filepath.Join(root, "previous.txt")); err != nil {
+		return "", err
+	}
+	if err = b.writeSlot(root, next, opts); err != nil {
+		return "", err
+	}
+	if opts.ExtraInstallStep != nil {
+		if err = opts.ExtraInstallStep(); err != nil {
+			return "", err
+		}
+	}
+	if err = stage(root, next, current); err != nil {
+		return "", err
+	}
+	return current, nil
+}
+func partitionOp(disk, target string, op func() error, info *blkid.Info) error {
+	return mount.PartitionOp(disk, []mount.Spec{{PartitionLabel: constants.EFIPartitionLabel, FilesystemType: partition.FilesystemTypeVFAT, MountTarget: target}}, op, []blkid.ProbeOption{blkid.WithSkipLocking(true)}, nil, nil, info)
+}
+
+// Upgrade stages the inactive slot without changing the normal firmware entry.
+func (b *Bootloader) Upgrade(opts options.InstallOptions) (*options.InstallResult, error) {
+	if err := b.CheckUpgrade(); err != nil {
+		return nil, err
+	}
+	var previous string
+	target := filepath.Join(opts.MountPrefix, constants.EFIMountPoint)
+	err := partitionOp(opts.BootDisk, target, func() error { var e error; previous, e = b.upgradeSlots(target, opts, RunningSlot()); return e }, opts.BlkidInfo)
+	return &options.InstallResult{PreviousLabel: previous}, err
+}
+func clearPending(root string) error {
+	if err := removeSynced(filepath.Join(root, pendingName)); err != nil {
+		return err
+	}
+	return removeSynced(filepath.Join(root, "tryboot.txt"))
+}
+
+// finishBoot handles both successful trials and boots of the untouched fallback.
+// config.txt is authoritative even if power was lost during a previous commit.
+func finishBoot(root, running string, trial bool) error {
+	active, err := activeSlot(root)
+	if err != nil {
+		return err
+	}
+	p, err := readPending(root)
+	if err != nil {
+		return err
+	}
+	if p == nil {
+		if running != active {
+			return errors.New("running slot does not match committed configuration")
+		}
+		return nil
+	}
+	if running == active {
+		return clearPending(root)
+	}
+	if !trial || running != p.Slot || active != p.Previous {
+		return errors.New("boot does not match pending trial")
+	}
+	if err = verifySlot(root, running); err != nil {
+		return err
+	}
+	if err = atomicWrite(filepath.Join(root, "previous.txt"), configFor(active, false)); err != nil {
+		return err
+	}
+	if err = atomicWrite(filepath.Join(root, "config.txt"), configFor(running, false)); err != nil {
+		return err
+	}
+	return clearPending(root)
+}
+func revertSlots(root, running string) error {
+	active, err := activeSlot(root)
+	if err != nil {
+		return err
+	}
+	p, err := readPending(root)
+	if err != nil {
+		return err
+	}
+	if p != nil {
+		return clearPending(root)
+	} // cancel a failed or unbooted candidate
+	data, err := os.ReadFile(filepath.Join(root, "previous.txt"))
+	if err != nil {
+		return fmt.Errorf("no rollback slot: %w", err)
+	}
+	previous, err := configSlot(data)
+	if err != nil {
+		return err
+	}
+	if running != active || previous == active {
+		return errors.New("invalid rollback selection")
+	}
+	return stage(root, previous, active)
+}
+
+// Revert cancels a pending trial, or trials the previous committed image.
+func (b *Bootloader) Revert(disk string) error {
+	if b.Layout != abMarkerValue {
+		return errors.New("legacy Pi layout cannot rollback")
+	}
+	return partitionOp(disk, constants.EFIMountPoint, func() error { return revertSlots(constants.EFIMountPoint, RunningSlot()) }, nil)
+}
