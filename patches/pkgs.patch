diff --git a/wireless-regdb/pkg.yaml b/wireless-regdb/pkg.yaml
new file mode 100644
index 0000000..5bf5056
--- /dev/null
+++ b/wireless-regdb/pkg.yaml
@@ -0,0 +1,31 @@
+name: wireless-regdb
+variant: scratch
+shell: /bin/bash
+dependencies:
+  - stage: base
+steps:
+  - sources:
+      - url: https://www.kernel.org/pub/software/network/wireless-regdb/wireless-regdb-{{ .wireless_regdb_version }}.tar.xz
+        destination: wireless-regdb.tar.xz
+        sha256: "{{ .wireless_regdb_sha256 }}"
+        sha512: "{{ .wireless_regdb_sha512 }}"
+    prepare:
+      - |
+        tar -xf wireless-regdb.tar.xz --strip-components=1
+    install:
+      - |
+        install -D -m 0644 regulatory.db /rootfs/usr/lib/firmware/regulatory.db
+        install -D -m 0644 regulatory.db.p7s /rootfs/usr/lib/firmware/regulatory.db.p7s
+    test:
+      - |
+        fhs-validator /rootfs
+    sbom:
+      outputPath: /rootfs/usr/share/spdx/wireless-regdb.spdx.json
+      version: {{ .wireless_regdb_version }}
+      cpes:
+        - cpe:2.3:a:kernel:wireless-regdb:{{ .wireless_regdb_version }}:*:*:*:*:*:*:*
+      licenses:
+        - ISC
+finalize:
+  - from: /rootfs
+    to: /
diff --git a/wpa-supplicant/pkg.yaml b/wpa-supplicant/pkg.yaml
new file mode 100644
index 0000000..d6e60a0
--- /dev/null
+++ b/wpa-supplicant/pkg.yaml
@@ -0,0 +1,47 @@
+name: wpa-supplicant
+variant: scratch
+shell: /bin/bash
+dependencies:
+  - stage: base
+steps:
+  - sources:
+      - url: https://w1.fi/releases/wpa_supplicant-{{ .wpa_supplicant_version }}.tar.gz
+        destination: wpa_supplicant.tar.gz
+        sha256: "{{ .wpa_supplicant_sha256 }}"
+        sha512: "{{ .wpa_supplicant_sha512 }}"
+    prepare:
+      - |
+        tar -xzf wpa_supplicant.tar.gz --strip-components=1
+
+        cat > wpa_supplicant/.config <<'EOF'
+        CONFIG_DRIVER_NL80211=y
+        CONFIG_LIBNL32=y
+        CONFIG_TLS=openssl
+        CONFIG_CTRL_IFACE=y
+        CONFIG_BACKEND=file
+        CONFIG_IEEE80211W=y
+        CONFIG_SAE=y
+        CONFIG_NO_ROAMING=y
+        EOF
+    build:
+      - |
+        make -C wpa_supplicant -j $(nproc) LDFLAGS="-static" wpa_supplicant wpa_cli wpa_passphrase
+    install:
+      - |
+        install -D -m 0755 wpa_supplicant/wpa_supplicant /rootfs/usr/bin/wpa_supplicant
+        install -D -m 0755 wpa_supplicant/wpa_cli /rootfs/usr/bin/wpa_cli
+        install -D -m 0755 wpa_supplicant/wpa_passphrase /rootfs/usr/bin/wpa_passphrase
+        strip /rootfs/usr/bin/wpa_supplicant /rootfs/usr/bin/wpa_cli /rootfs/usr/bin/wpa_passphrase
+    test:
+      - |
+        fhs-validator /rootfs
+    sbom:
+      outputPath: /rootfs/usr/share/spdx/wpa-supplicant.spdx.json
+      version: {{ .wpa_supplicant_version }}
+      cpes:
+        - cpe:2.3:a:w1.fi:wpa_supplicant:{{ .wpa_supplicant_version }}:*:*:*:*:*:*:*
+      licenses:
+        - BSD-3-Clause
+finalize:
+  - from: /rootfs
+    to: /
